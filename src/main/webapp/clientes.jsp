<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Contacto | BYTE TECH</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head>
<body><header class="topbar"><a class="logo" href="${pageContext.request.contextPath}/inicio">BYTE<span>TECH</span></a><nav><a href="${pageContext.request.contextPath}/inicio">Inicio</a><a href="${pageContext.request.contextPath}/productos">Productos</a><a class="active" href="${pageContext.request.contextPath}/clientes">Contáctanos</a></nav></header>
<main class="form-layout"><section><p class="eyebrow">HABLEMOS DE TECNOLOGÍA</p><h1 class="page-title">Estamos para <span>ayudarte.</span></h1><p class="lead">Completa el formulario para registrar tu solicitud de información sobre nuestros equipos.</p><div class="contact-note"><b>BYTE TECH</b><p>Asesoría para computadores, componentes y accesorios tecnológicos.</p></div></section>
<section class="form-card"><h2>Formulario de contacto</h2><p class="muted">Los campos marcados son obligatorios.</p><% if (request.getAttribute("error") != null) { %><div class="alert"><%= request.getAttribute("error") %></div><% } %>
<form method="post" action="${pageContext.request.contextPath}/clientes"><label for="nombre">Nombre completo</label><input id="nombre" name="nombre" type="text" maxlength="80" required value="<%= request.getParameter("nombre") == null ? "" : request.getParameter("nombre") %>"><label for="correo">Correo electrónico</label><input id="correo" name="correo" type="email" maxlength="100" required value="<%= request.getParameter("correo") == null ? "" : request.getParameter("correo") %>"><label for="telefono">Teléfono</label><input id="telefono" name="telefono" type="tel" maxlength="20" required value="<%= request.getParameter("telefono") == null ? "" : request.getParameter("telefono") %>"><label for="interes">¿Qué producto te interesa?</label><select id="interes" name="interes" required><option value="">Selecciona una opción</option><option>Computador gamer</option><option>Computador de escritorio</option><option>Portátil</option><option>Accesorios</option><option>Asesoría general</option></select><button class="btn primary full" type="submit">Enviar solicitud</button></form></section></main><footer>© 2026 BYTE TECH · Proyecto académico SENA.</footer></body></html>
