<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="com.bytetech.model.Cliente" %>
<% Cliente cliente = (Cliente) request.getAttribute("cliente"); %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Solicitud recibida | BYTE TECH</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head><body><header class="topbar"><a class="logo" href="${pageContext.request.contextPath}/inicio">BYTE<span>TECH</span></a><nav><a href="${pageContext.request.contextPath}/inicio">Inicio</a><a href="${pageContext.request.contextPath}/productos">Productos</a></nav></header><main class="success-wrap"><div class="success-icon">✓</div><p class="eyebrow">SOLICITUD PROCESADA</p><h1>¡Gracias, <span><%= cliente.getNombre() %></span>!</h1><p class="lead">Tu formulario fue recibido correctamente por la aplicación BYTE TECH.</p><div class="summary"><p><b>Correo:</b> <%= cliente.getCorreo() %></p><p><b>Teléfono:</b> <%= cliente.getTelefono() %></p><p><b>Interés:</b> <%= cliente.getInteres() %></p></div><a class="btn primary" href="${pageContext.request.contextPath}/inicio">Volver al inicio</a><p class="muted note">Demostración académica: los datos se procesan durante la solicitud y no se guardan en una base de datos.</p></main><footer>© 2026 BYTE TECH · Proyecto académico SENA.</footer></body></html>
