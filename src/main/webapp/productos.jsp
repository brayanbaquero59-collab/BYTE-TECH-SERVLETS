<%@ page contentType="text/html; charset=UTF-8" pageEncoding="UTF-8" %>
<%@ page import="java.util.List,com.bytetech.servlet.ProductoServlet.Producto" %>
<!DOCTYPE html><html lang="es"><head><meta charset="UTF-8"><meta name="viewport" content="width=device-width, initial-scale=1.0"><title>Productos | BYTE TECH</title><link rel="stylesheet" href="${pageContext.request.contextPath}/css/estilos.css"></head>
<body><header class="topbar"><a class="logo" href="${pageContext.request.contextPath}/inicio">BYTE<span>TECH</span></a><nav><a href="${pageContext.request.contextPath}/inicio">Inicio</a><a class="active" href="${pageContext.request.contextPath}/productos">Productos</a><a href="${pageContext.request.contextPath}/clientes">Contáctanos</a></nav></header>
<main class="page"><p class="eyebrow">CATÁLOGO BYTE TECH</p><h1 class="page-title">Encuentra tu próximo <span>equipo.</span></h1><p class="lead">Explora algunas de nuestras soluciones tecnológicas.</p>
<form class="search" method="get" action="${pageContext.request.contextPath}/productos"><input type="search" name="buscar" placeholder="Buscar por nombre o categoría" value="<%= request.getAttribute("busqueda") %>"><button class="btn primary" type="submit">Buscar</button></form>
<div class="product-grid"><% List<Producto> productos = (List<Producto>) request.getAttribute("productos"); if (productos != null && !productos.isEmpty()) { for (Producto p : productos) { %>
<article class="product-card"><div class="product-visual"><div class="device-icon">▣</div><span class="tag"><%= p.categoria() %></span></div><div class="product-info"><h2><%= p.nombre() %></h2><p><%= p.descripcion() %></p><strong><%= p.precio() %></strong><a href="${pageContext.request.contextPath}/clientes" class="text-link">Solicitar información →</a></div></article>
<% } } else { %><p>No encontramos productos con esa búsqueda. Intenta con otra palabra.</p><% } %></div></main><footer>© 2026 BYTE TECH · Proyecto académico SENA.</footer></body></html>
